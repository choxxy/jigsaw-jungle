<!DOCTYPE html>
<html lang="en" dir="ltr">
{{> header}}
<body>
<nav>
    <div class="nav-content">
        <div class="logo">
            <img src="images/jigsawjungle.png"  alt="site-logo"/>
            <h2>Jigsaw Jungle</h2>
        </div>
<!--        <ul class="nav-links">-->
<!--            <li><a href="studio">Create</a></li>-->
<!--            <li><a href="#">About</a></li>-->
<!--            <li><a href="#">Contact</a></li>-->
<!--        </ul>-->
    </div>
</nav>
<section class="gallery">
    <ul class="images">
        {{#photos}}
            <li class="card" onclick="itemClicked(this)">
                <img id="{{id}}" src="{{photoUrl}}" alt="img">
                <div class="details">
                    <div class="stats">
                        <img class="like" src="images/like.svg"/>  <span>{{likes}}</span>   <img class="played" src="images/played.svg"/> <span>{{played}}</span>
                    </div>
                </div>
            </li>
        {{/photos}}
    </ul>
</section>
<script src="js/index.js"></script>
</body>
</html>
